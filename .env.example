# Encryptr Server configuration — every setting is environment-driven.
# Copy to .env for local development (loaded by docker compose, not the binary).

# development | testing | production
ENVIRONMENT=development
BIND_ADDR=0.0.0.0:8080

# --- Database ---
DATABASE_URL=postgres://encryptr:encryptr@localhost:5432/encryptr
DATABASE_MAX_CONNECTIONS=10

# --- Auth ---
# Must be at least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-value-please
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000

# --- AI provider: openai | anthropic | ollama ---
PROVIDER=ollama
# PROVIDER_DEFAULT_MODEL=llama3.2
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
OLLAMA_BASE_URL=http://localhost:11434

# --- Rate limiting (per client IP, fixed window) ---
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECS=60
AUTH_RATE_LIMIT_REQUESTS=10
# Only enable behind a trusted reverse proxy that OVERWRITES X-Forwarded-For.
# When false (default) the socket peer IP is used, which clients cannot spoof.
TRUST_PROXY_HEADERS=false

# --- HTTP ---
# Comma-separated browser origins allowed by CORS (empty = deny cross-origin)
CORS_ALLOWED_ORIGINS=
REQUEST_BODY_LIMIT_BYTES=1048576
# Overall timeout for non-streaming requests (the WebSocket stream is exempt).
REQUEST_TIMEOUT_SECS=30

# --- Postgres (docker compose) ---
# POSTGRES_USER=encryptr
# POSTGRES_PASSWORD=encryptr
# POSTGRES_DB=encryptr

# --- TLS (optional; terminate at a proxy instead if you prefer) ---
# TLS_CERT_PATH=/certs/cert.pem
# TLS_KEY_PATH=/certs/key.pem

# --- Logging ---
# LOG_JSON defaults to true in production, false otherwise
# LOG_JSON=true
# RUST_LOG=info,sqlx=warn
